<?xml version="1.0"?>
<ruleset name="Mammoth WP Kit">
    <description>WPCS prefix and text-domain checks for mammothwp/wp-kit.</description>

    <file>src</file>
    <file>bootstrap.php</file>
    <file>compat.php</file>
    <file>version.php</file>
    <arg name="extensions" value="php"/>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="mmwp"/>
                <element value="MammothWP"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wp-kit"/>
            </property>
        </properties>
    </rule>
</ruleset>
